# ==============================================================
# Database Configuration
# Replace YOUR_DB_NAME, YOUR_MYSQL_USERNAME, YOUR_MYSQL_PASSWORD
# ==============================================================
spring.datasource.url=jdbc:mysql://localhost:3306/YOUR_DB_NAME?useSSL=false&serverTimezone=UTC&skipNameResolve=true&cachePrepStmts=true&useServerPrepStmts=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# HikariCP Connection Pool Settings
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.maximum-pool-size=15
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000

# ==============================================================
# Security & JWT Configuration
# Generate a secure 256-bit+ secret key for production
# ==============================================================
app.jwt.secret=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
app.jwt.expiration=86400000

# Server Configuration
server.port=8080
server.address=0.0.0.0

# Optional CORS Override (Default is '*' allowing all origins)
# app.cors.allowed-origin=http://localhost:5173